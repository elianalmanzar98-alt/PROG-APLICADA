@page "/Prestamos"
@page "/Prestamos/{EstudianteId:int}"
@rendermode RenderMode.InteractiveServer
@using GestionLibros.Models
@using GestionLibros.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.QuickGrid
@using GestionLibros.Components.Pages
@inject PrestamoService prestamoService
@inject EstudianteService estudianteService
@inject NavigationManager navManager

<PageTitle>Préstamos</PageTitle>

<div class="card shadow mt-4 border-0 rounded-3">
    <div class="card-header bg-dark text-white py-3 rounded-top d-flex justify-content-between align-items-center">
        <h3 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i><strong>@Titulo</strong></h3>
        @if (EstudianteId > 0)
        {
            <a href="/Estudiante/Index" class="btn btn-outline-light btn-sm">Volver</a>
        }
    </div>
    <div class="card-body bg-light">
        <div class="d-flex mb-3 gap-2">
            <button class="btn @(soloActivos ? "btn-dark" : "btn-outline-dark")" @onclick="() => CambiarFiltro(true)">Prestados</button>
            <button class="btn @(!soloActivos ? "btn-dark" : "btn-outline-dark")" @onclick="() => CambiarFiltro(false)">Todos</button>
        </div>

        <div class="table-responsive bg-white rounded shadow-sm p-2">
            <QuickGrid Items="@listaPrestamos.AsQueryable()" Class="table table-hover align-middle text-center mb-0">
                <PropertyColumn Property="@(prestamo => prestamo.PrestamoId)" Title="ID" />
            <TemplateColumn Title="Libro" Context="prestamo">@prestamo.libros?.Titulo</TemplateColumn>
<TemplateColumn Title="Estudiante" Context="prestamo">@prestamo.estudiante?.Nombres</TemplateColumn>
                <TemplateColumn Title="Fecha Préstamo" Context="prestamo">@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</TemplateColumn>
                <TemplateColumn Title="Fecha Devolución">
                    @(context.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "-")
                </TemplateColumn>
                <TemplateColumn Title="Acciones">
                    @if (context.FechaDevolucion == null)
                    {
                        <button class="btn btn-success btn-sm" @onclick="() => AbrirConfirmacionDevolver(context)">
                            Devolver
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Devuelto</span>
                    }
                </TemplateColumn>
            </QuickGrid>
        </div>
    </div>
</div>

<ModalConfirmacion @ref="modalDevolver"
                    Titulo="Registrar devolucion"
                    Mensaje="@mensajeDevolver"
                    TextoBotonConfirmar="Devolver"
                    BotonConfirmarClase="btn-success"
                    OnConfirmar="ConfirmarDevolucion" />

@code {
    [Parameter] public int EstudianteId { get; set; }

    public List<Prestamo> listaPrestamos = new List<Prestamo>();
    public string Titulo = "Prestamos";
    public bool soloActivos = true;

    private ModalConfirmacion? modalDevolver;
    private int prestamoADevolverId;
    private string mensajeDevolver = "";

    protected override async Task OnInitializedAsync()
    {
        if (EstudianteId > 0)
        {
            var estudiante = (await estudianteService.Listar(e => e.EstudianteId == EstudianteId)).FirstOrDefault();
            Titulo = estudiante != null ? $"Prestamos de {estudiante.Nombres}" : "Prestamos";
        }

        await CargarPrestamos();
    }

    private async Task CargarPrestamos()
    {
        var idEstudiante = EstudianteId;
        var activos = soloActivos;
        listaPrestamos = await prestamoService.Listar(p =>
            (idEstudiante == 0 || p.EstudianteId == idEstudiante) &&
            (!activos || p.FechaDevolucion == null));
    }

    private async Task CambiarFiltro(bool activos)
    {
        soloActivos = activos;
        await CargarPrestamos();
    }

    private void AbrirConfirmacionDevolver(Prestamo prestamo)
    {
        prestamoADevolverId = prestamo.PrestamoId;
        mensajeDevolver = $"Confirma la devolucion de este prestamo por parte de {prestamo.estudiante?.Nombres}?";
        modalDevolver?.Abrir();
    }

    private async Task ConfirmarDevolucion()
    {
        var devuelto = await prestamoService.Devolver(prestamoADevolverId);
        if (devuelto)
        {
            await CargarPrestamos();
        }
    }

    }