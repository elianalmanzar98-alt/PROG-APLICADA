@page "/crear-libro"
@page "/editar-libro/{LibroId:int}"
@rendermode RenderMode.InteractiveServer
@using GestionLibros.Models
@using GestionLibros.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject LibroService libroService
@inject NavigationManager navManager

<PageTitle>@(LibroId > 0 ? "Modificar Libro" : "Nuevo Registro")</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-3 rounded-top">
                    <h3 class="mb-0">
                        <i class="bi bi-book me-2"></i>
                        <strong>@(LibroId > 0 ? "Actualizar Datos del Libro" : "Registrar Nuevo Libro")</strong>
                    </h3>
                </div>

                <div class="card-body p-4 bg-light">
                    <EditForm Model="libro" OnValidSubmit="Guardar">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger shadow-sm border-start border-danger border-4">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensajeError
                            </div>
                        }

                        <ValidationSummary class="alert alert-warning shadow-sm" />

                        <div class="bg-white p-4 rounded shadow-sm border">
                        
                            <div class="mb-3">
                                <label class="form-label text-muted fw-bold">ID del Libro</label>
                                <InputNumber class="form-control bg-light text-muted" @bind-Value="libro.LibroId" readonly />
                            </div>

                            
                            <div class="mb-3">
                                <label class="form-label text-dark fw-bold">Título</label>
                                <InputText class="form-control border-secondary" @bind-Value="libro.Titulo" placeholder="Ej. Cien Años de Soledad" />
                                <ValidationMessage For="@(() => libro.Titulo)" class="text-danger small mt-1" />
                            </div>

                            
                            <div class="mb-3">
                                <label class="form-label text-dark fw-bold">Autor</label>
                                <InputText class="form-control border-secondary" @bind-Value="libro.Autor" placeholder="Ej. Gabriel García Márquez" />
                                <ValidationMessage For="@(() => libro.Autor)" class="text-danger small mt-1" />
                            </div>

                            
                            <div class="mb-3">
                                <label class="form-label text-dark fw-bold">Año de Publicación</label>
                                <InputNumber class="form-control border-secondary" @bind-Value="libro.AnoPublicacion" />
                                <ValidationMessage For="@(() => libro.AnoPublicacion)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="button" class="btn btn-outline-secondary px-4 shadow-sm" @onclick="Volver">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar
                            </button>
                            <button type="submit" class="btn btn-dark px-5 shadow-sm">
                                <i class="bi bi-floppy me-1"></i> @(LibroId > 0 ? "Guardar Cambios" : "Registrar")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    
    [Parameter]
    public int LibroId { get; set; }

    public Libros libro { get; set; } = new Libros();
    public string mensajeError { get; set; } = "";

    protected override void OnInitialized()
    {
        if (LibroId > 0)
        {
            var libroEncontrado = libroService.Obtener(LibroId);
            if (libroEncontrado != null)
            {
                libro = libroEncontrado;
            }
        }
    }

    public void Guardar()
    {
        mensajeError = "";

        if (libroService.ExisteTitulo(libro.Titulo, libro.LibroId))
        {
            mensajeError = "no se puede registrar existe un libro con el mismo titulo";
            return;
        }

        var guardado = libroService.Guardar(libro);
        if (guardado)
        {
            Volver();
        }
    }

    public void Volver()
    {
        navManager.NavigateTo("/libros");
    }
}