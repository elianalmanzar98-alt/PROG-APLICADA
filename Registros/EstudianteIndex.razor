@page "/Estudiante/Index"

@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using GestionLibros.Models
@using GestionLibros.Services
@using Microsoft.AspNetCore.Components.QuickGrid

@inject EstudianteService estudiantesService
@rendermode InteractiveServer

<PageTitle>Lista de Estudiantes</PageTitle>

<div class="card shadow-lg m-4">
    <div class="card-header text-center">
        <h5>Registro de Estudiantes</h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col text-end">
                <a href="/Estudiante/Create" class="btn btn-primary bi bi-plus-circle"> Nuevo Estudiante</a>
            </div>
        </div>

        <QuickGrid Items="@ListaEstudiantes.AsQueryable()" Class="table table-bordered table-striped">
            <PropertyColumn Property="@(e => e.EstudianteId)" Title="Id" />
            <PropertyColumn Property="@(e => e.Nombres)" Title="Nombres" />
            <PropertyColumn Property="@(e => e.Direccion)" Title="Dirección" />
            <PropertyColumn Property="@(e => e.Email)" Title="Email" />
            <TemplateColumn Title="Fecha Nacimiento">
                @(context.FechaNacimiento?.ToString("dd/MM/yyyy"))
            </TemplateColumn>
            <TemplateColumn Title="Acciones">
                <a href="/Prestamos/@context.EstudianteId" class="btn btn-outline-primary btn-sm">
                    Libros prestados
                </a>
                <button class="btn btn-danger btn-sm ms-1" @onclick="() => AbrirConfirmacionEliminar(context)">
                    Eliminar
                </button>
            </TemplateColumn>
        </QuickGrid>
    </div>
</div>

@if (mostrarConfirmacion)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar estudiante</h5>
                    <button type="button" class="btn-close" @onclick="CerrarConfirmacion"></button>
                </div>
                <div class="modal-body">@mensajeEliminar</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarConfirmacion">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public List<Estudiante> ListaEstudiantes { get; set; } = new List<Estudiante>();

    private bool mostrarConfirmacion;
    private int estudianteAEliminarId;
    private string mensajeEliminar = "";

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudiantesService.Listar(e => true);
    }

    private void AbrirConfirmacionEliminar(Estudiante estudiante)
    {
        estudianteAEliminarId = estudiante.EstudianteId;
        mensajeEliminar = $"desea eliminar al estudiante \"{estudiante.Nombres}\"?";
        mostrarConfirmacion = true;
    }

    private void CerrarConfirmacion()
    {
        mostrarConfirmacion = false;
    }

    private async Task ConfirmarEliminar()
    {
        var eliminado = await estudiantesService.Eliminar(estudianteAEliminarId);
        if (eliminado)
        {
            ListaEstudiantes = await estudiantesService.Listar(e => true);
        }

        CerrarConfirmacion();
    }
}