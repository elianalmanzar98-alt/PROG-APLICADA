@page "/libros"
@rendermode RenderMode.InteractiveServer
@using GestionLibros.Models
@using GestionLibros.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@inject LibroService libroService
@inject NavigationManager navManager

<PageTitle>Consulta de Libros</PageTitle>

<div class="card shadow mt-4 border-0 rounded-3">
    <div class="card-header bg-dark text-white py-3 rounded-top">
        <h3 class="mb-0"><i class="bi bi-journal-text me-2"></i><strong>Catálogo de Libros</strong></h3>
    </div>

    <div class="card-body bg-light">
        
        <div class="row mb-4 align-items-end p-3 bg-white rounded shadow-sm">
            <div class="col-md-3">
                <label class="form-label text-muted"><strong>Filtrar por:</strong></label>
                <select class="form-select border-secondary" @bind="filtro">
                    <option value="0">Elija una opción...</option>
                    <option value="1">LibroId</option>
                    <option value="2">Título</option>
                    <option value="3">Autor</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label text-muted"><strong>Término de búsqueda:</strong></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Escribe aquí para buscar..." @bind="valorBusqueda" />
                </div>
            </div>
            <div class="col-md-4 text-end">
                <button class="btn btn-dark px-4" @onclick="Buscar">Buscar</button>
                <button class="btn btn-outline-secondary ms-2" @onclick="Restablecer">Limpiar</button>
            </div>
        </div>

        
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-borderless align-middle text-center mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Año</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var libro in listaLibros)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@libro.LibroId</span></td>
                            <td class="fw-bold">@libro.Titulo</td>
                            <td>@libro.Autor</td>
                            <td>@libro.AnoPublicacion</td>
                            <td>
                                <a href="/editar-libro/@libro.LibroId" class="btn btn-warning btn-sm shadow-sm text-dark fw-bold px-3">
                                    Editar
                                </a>
                                <button class="btn btn-danger btn-sm shadow-sm px-3 ms-1" @onclick="() => Eliminar(libro.LibroId)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3 px-2">
            <span class="text-muted">Total de registros: <strong>@listaLibros.Count</strong></span>
            <a href="/crear-libro" class="btn btn-success shadow px-4">
                <i class="bi bi-plus-circle me-1"></i> Agregar Nuevo Libro
            </a>
        </div>
    </div>
</div>

@code {
   
    public List<Libros> listaLibros = new List<Libros>();
    public int filtro = 0;
    public string valorBusqueda = "";

    protected override void OnInitialized()
    {
        listaLibros = libroService.Listar(l => true);
    }

    public void Buscar()
    {
        if (string.IsNullOrWhiteSpace(valorBusqueda))
        {
            listaLibros = libroService.Listar(l => true);
            return;
        }

        if (filtro == 1 && int.TryParse(valorBusqueda, out int id))
        {
            listaLibros = libroService.Listar(l => l.LibroId == id);
        }
        else if (filtro == 2)
        {
            listaLibros = libroService.Listar(l => l.Titulo.ToLower().Contains(valorBusqueda.ToLower()));
        }
        else if (filtro == 3)
        {
            listaLibros = libroService.Listar(l => l.Autor.ToLower().Contains(valorBusqueda.ToLower()));
        }
    }

    public void Restablecer()
    {
        filtro = 0;
        valorBusqueda = "";
        listaLibros = libroService.Listar(l => true);
    }

    public void Eliminar(int id)
    {
        var eliminado = libroService.Eliminar(id);
        if (eliminado)
        {
            listaLibros = libroService.Listar(l => true);
        }
    }
}