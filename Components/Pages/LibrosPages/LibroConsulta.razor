@page "/Libro/Consulta"
@inject LibrosService librosService
@rendermode InteractiveServer

<PageTitle>Consulta de Libros</PageTitle>

<div class="card shadow-lg m-4">
    <div class="card-header text-center">
        <h3>Consulta de Libros</h3>
    </div>
    <div class="card-body">
        <div class="row mb-3 align-items-end">
            <div class="col-3">
                <label class="form-label"><strong>Filtrar por</strong></label>
                <select class="form-select" @bind="Filtro">
                    <option value="">Elija una opción</option>
                    <option value="LibroId">LibroId</option>
                    <option value="Titulo">Título</option>
                    <option value="Autor">Autor</option>
                </select>
            </div>
            <div class="col-4">
                <label class="form-label"><strong>Búsqueda</strong></label>
                <div class="input-group">
                    <input class="form-control" placeholder="Buscar" @bind="ValorBusqueda" />
                    <button class="btn btn-outline-primary" @onclick="Buscar">Buscar</button>
                </div>
            </div>
            <div class="col-2">
                <button class="btn btn-outline-secondary" @onclick="Restablecer">Restablecer</button>
            </div>
        </div>

        <table class="table table-bordered text-center align-middle">
            <thead>
                <tr>
                    <th>LibroId</th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Año de Publicación</th>
                    <th>Veces prestado</th>
                    <th>Promedio de días prestado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Lista)
                {
                    <tr>
                        <td>@item.Libro.LibroId</td>
                        <td>@item.Libro.Titulo</td>
                        <td>@item.Libro.Autor</td>
                        <td>@item.Libro.AnoPublicacion</td>
                        <td>@item.VecesPrestado</td>
                        <td>@(item.VecesPrestado == 0 ? "-" : item.PromedioDias.ToString("0.0"))</td>
                    </tr>
                }
            </tbody>
        </table>

        <p><strong>Cantidad:</strong> @Lista.Count</p>
    </div>
</div>

@code {
    public List<LibroConPromedio> Lista { get; set; } = new();
        
    public string Filtro { get; set; } = "";


    public string ValorBusqueda { get; set; } = "";


    protected override async Task OnInitializedAsync()
    {
        Lista = await librosService.ListarConPromedio(l => true);
    }

    public async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(ValorBusqueda) || string.IsNullOrEmpty(Filtro))
        {
            Lista = await librosService.ListarConPromedio(l => true);
            return;
        }

        var valor = ValorBusqueda.ToLower();
        if (Filtro == "LibroId")
        {
            Lista = int.TryParse(ValorBusqueda, out var id)
                ? await librosService.ListarConPromedio(l => l.LibroId == id): new List<LibroConPromedio>();
        }
        else if (Filtro == "Titulo")
            Lista = await librosService.ListarConPromedio(l => l.Titulo.ToLower().Contains(valor));
        else if (Filtro == "Autor")
            Lista = await librosService.ListarConPromedio(l => l.Autor.ToLower().Contains(valor));
    }

    public async Task Restablecer()
    {
        Filtro = "";
        ValorBusqueda = "";
        Lista = await librosService.ListarConPromedio(l => true);
    }
}